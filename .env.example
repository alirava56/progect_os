# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required only to create first owner. Remove after setup.
PROJECTOS_SETUP_TOKEN=
# Keep path on private disk; do not place DB inside public/ or commit it.
PROJECTOS_DB_PATH=./local-data/projectos.sqlite
# Production unsafe-method requests fail closed unless the canonical HTTPS origin is declared.
# Must equal the browser Origin exactly, e.g. https://projectos.example.com
PROJECTOS_PUBLIC_ORIGIN=
# Use secure TLS before hosting outside localhost.
# No real secrets or API keys belong in project data.

# Optional MFA encryption key (64 hex characters); retain securely, never commit.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROJECTOS_MFA_ENCRYPTION_KEY=
# Set only for the encrypted backup process, never in client code.
PROJECTOS_BACKUP_PASSPHRASE=
# Optional, explicit HTTPS monitoring hosts; disabled unless configured.
PROJECTOS_MONITOR_HOSTS=

# Telegram notification opt-in. Keep tokens server-side, never in client bundles.
PROJECTOS_TELEGRAM_NOTIFICATIONS=disabled
PROJECTOS_TELEGRAM_BOT_TOKEN=
PROJECTOS_TELEGRAM_CHAT_ID=

# Optional read-only GitHub API access; use a fine-grained token scoped to listed repos.
PROJECTOS_GITHUB_TOKEN=
PROJECTOS_GITHUB_REPOS=

# Optional AI. Never enable external document transmission without explicit user consent.
PROJECTOS_AI_ENABLED=disabled
PROJECTOS_AI_SEND_DOCS=disabled
PROJECTOS_OPENAI_API_KEY=
PROJECTOS_AI_MODEL=
